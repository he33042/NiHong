# ===== 服务器配置 =====
PORT=3000
NODE_ENV=development

# ===== MySQL 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=blog

# ===== JWT 配置 =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== bcrypt 加密强度 =====
BCRYPT_SALT_ROUNDS=10

# ===== 跨域配置（多个来源用逗号分隔）=====
CORS_ORIGIN=*

# ===== 默认管理员账号（启动时自动创建/更新）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_NICKNAME=博主
