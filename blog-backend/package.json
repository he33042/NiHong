{
  "name": "blog-backend",
  "version": "1.0.0",
  "description": "个人博客后端 RESTful API（Express + mysql2 + JWT + bcrypt），对接 Vue3 前端",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/scripts/createAdmin.js",
